# Copy to .env (or .env.local) and fill in. No real secrets in this file.
# `pnpm local:setup` writes a ready .env.local for the local emulator instead.

# ---- Browser build (public, end up in the site bundle) ----------------------
# Supabase project URL and the anon (public) key: Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
# VAPID public key for Web Push (pnpm vapid:keys). Empty = reminders fall back to the .ics file.
VITE_VAPID_PUBLIC_KEY=

# ---- Operator scripts only (tenant:publish / tenant:verify) -----------------
# NEVER put these into Cloudflare Pages build variables or anything prefixed VITE_.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Deployed site, used by tenant:verify when --site is not given.
SITE_URL=https://<project>.pages.dev

# ---- Edge Function secrets (set with `supabase secrets set`, not here) --------
# VAPID_PUBLIC_KEY=<same as VITE_VAPID_PUBLIC_KEY>
# VAPID_PRIVATE_KEY=<from pnpm vapid:keys>
# VAPID_SUBJECT=mailto:you@example.com
# NOTIFY_CRON_SECRET=<random string, also stored in Vault as notify_dispatch_secret>
