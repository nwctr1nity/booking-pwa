{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["scripts/**/*.ts", "tests/db/**/*.ts", "tests/functions/**/*.ts", "tests/e2e/**/*.ts", "playwright.config.ts", "vitest.config.ts"]
}
