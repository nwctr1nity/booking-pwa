{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "short_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24
    },
    "kind": {
      "default": "detailing",
      "type": "string",
      "enum": [
        "detailing",
        "service",
        "tire",
        "wash",
        "other"
      ]
    },
    "timezone": {
      "type": "string"
    },
    "currency": {
      "default": "RUB",
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "locale": {
      "default": "ru-RU",
      "type": "string"
    },
    "accent_color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "tagline": {
      "default": "",
      "type": "string",
      "maxLength": 120
    },
    "description": {
      "default": "",
      "type": "string",
      "maxLength": 1000
    },
    "contacts": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string",
          "minLength": 5,
          "maxLength": 200
        },
        "address_note": {
          "default": "",
          "type": "string",
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+?[0-9 ()-]{10,20}$"
        },
        "map_url": {
          "type": "string",
          "format": "starts_with",
          "pattern": "^https:\\/\\/.*"
        }
      },
      "required": [
        "address",
        "phone"
      ]
    },
    "booking": {
      "default": {},
      "type": "object",
      "properties": {
        "cancellation_hours": {
          "default": 12,
          "type": "integer",
          "minimum": 0,
          "maximum": 168
        },
        "slot_step_minutes": {
          "default": 30,
          "anyOf": [
            {
              "type": "number",
              "const": 15
            },
            {
              "type": "number",
              "const": 20
            },
            {
              "type": "number",
              "const": 30
            },
            {
              "type": "number",
              "const": 60
            }
          ]
        },
        "min_notice_minutes": {
          "default": 60,
          "type": "integer",
          "minimum": 0,
          "maximum": 2880
        },
        "horizon_days": {
          "default": 30,
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "reminder_hours": {
          "default": 24,
          "type": "integer",
          "minimum": 1,
          "maximum": 72
        }
      }
    },
    "images": {
      "type": "object",
      "properties": {
        "logo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+\\.(jpe?g|png|webp|avif)$"
        },
        "hero": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+\\.(jpe?g|png|webp|avif)$"
        }
      },
      "required": [
        "logo",
        "hero"
      ]
    },
    "info_cards": {
      "default": [],
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "icon": {
            "type": "string",
            "enum": [
              "shield-check",
              "sparkle",
              "star",
              "camera",
              "coffee",
              "timer",
              "clock",
              "warehouse",
              "wrench",
              "car",
              "drop",
              "medal",
              "thumbs-up"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "text": {
            "default": "",
            "type": "string",
            "maxLength": 160
          }
        },
        "required": [
          "title"
        ]
      }
    },
    "resources": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "required": [
          "key",
          "name"
        ]
      }
    },
    "services": {
      "minItems": 1,
      "maxItems": 60,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "category": {
            "default": "",
            "type": "string",
            "maxLength": 40
          },
          "description": {
            "default": "",
            "type": "string",
            "maxLength": 400
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000000
          },
          "price_is_from": {
            "default": false,
            "type": "boolean"
          },
          "duration_minutes": {
            "type": "integer",
            "minimum": 15,
            "maximum": 20160
          },
          "buffer_minutes": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 1440
          },
          "resources": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
            }
          }
        },
        "required": [
          "key",
          "name",
          "price",
          "duration_minutes",
          "resources"
        ]
      }
    },
    "hours": {
      "type": "object",
      "properties": {
        "mon": {
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "tue": {
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "wed": {
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "thu": {
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "fri": {
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "sat": {
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "sun": {
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "required": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ]
    },
    "closed_dates": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "note": {
            "default": "",
            "type": "string",
            "maxLength": 120
          },
          "opens": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          },
          "closes": {
            "type": "string",
            "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
          }
        },
        "required": [
          "date"
        ]
      }
    },
    "gallery": {
      "default": [],
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
          },
          "image": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+\\.(jpe?g|png|webp|avif)$"
          },
          "caption": {
            "default": "",
            "type": "string",
            "maxLength": 140
          }
        },
        "required": [
          "key",
          "image"
        ]
      }
    },
    "owner": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        }
      },
      "required": [
        "email"
      ]
    }
  },
  "required": [
    "slug",
    "name",
    "short_name",
    "timezone",
    "accent_color",
    "contacts",
    "images",
    "resources",
    "services",
    "hours"
  ]
}
